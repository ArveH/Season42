<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Canonical Catalog test data; the iOS app will bundle this same file as its
         first-launch snapshot, keeping the app/API contract byte-identical. -->
    <Content Update="Data\catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
