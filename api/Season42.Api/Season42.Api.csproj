<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The canonical Catalog snapshot lives at the repo root, outside both projects,
         because the iOS app bundles the very same file as its first-launch snapshot.
         One file, two consumers: the app/API contract cannot drift (ADR-0003). -->
    <Content Include="..\..\catalog\catalog.json" Link="Data\catalog.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
