<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
	<!-- Everything else the app's Info.plist holds is generated by the build
	     (GENERATE_INFOPLIST_FILE), which merges its keys into this file. This is
	     for the one thing the build has to be told: BFF_BASE_URL, from
	     Bff.xcconfig next to this file. It lives here rather than under
	     Season42/ because that is a filesystem-synchronized group, which would
	     also copy it in as a resource. -->
	<key>BFFBaseURL</key>
	<string>$(BFF_BASE_URL)</string>
</dict>
</plist>
