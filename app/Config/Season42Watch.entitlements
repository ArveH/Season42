<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Watch App's, mirroring Season42.entitlements: the same iCloud container and the
	     same key-value store, so both apps read the one Library and the one Watching Order
	     (ADR-0022). Keep the two files naming the same things. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.season42.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- The iPhone app's store, named outright: the Watch App's bundle identifier is not
	     the one the store is called after. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.season42.app</string>
</dict>
</plist>
